# Copy to .env for local development. .env is git-ignored; never commit real secrets.
PORT=8080

# Neon "dev" branch, direct (not pooled) connection string.
# Used by `go run ./cmd/import load` and by the server locally.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Same dev branch: the store tests run in a throwaway schema there. Leave unset to skip them.
TEST_DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Where the server links audio files from.
AUDIO_BASE_URL=https://storage.googleapis.com/phrasebuilder-audio
